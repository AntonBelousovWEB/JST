{
	"name": "js-template",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "react-router dev",
		"typecheck": "react-router typegen && tsc -b --pretty false",
		"build": "npm run typecheck && react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"lint": "eslint . --cache --max-warnings 0",
		"lint:fix": "eslint . --cache --fix",
		"test": "vitest",
		"test:unit": "vitest run --passWithNoTests",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check": "npm run lint && npm run test:unit && npm run build",
		"template:reset": "node scripts/reset-template.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@mantine/core": "^9.5.2",
		"@mantine/hooks": "^9.5.2",
		"@needle-di/core": "^1.2.0",
		"@react-router/node": "^8.3.0",
		"@react-router/serve": "^8.3.0",
		"@reatom/core": "^1001.3.0",
		"@reatom/react": "^1001.0.1",
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.2.0",
		"@eslint-react/eslint-plugin": "^5.18.6",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "^8.3.0",
		"@react-router/fs-routes": "^8.3.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"eslint": "^10.9.1",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"typescript": "~5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"eslint-plugin-regexp": "3.1.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --cache --fix",
			"vitest related --run"
		],
		"*.{json,css,scss,html}": [
			"eslint --fix"
		]
	}
}
